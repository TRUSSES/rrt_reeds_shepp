<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rrt_pkg</name>
  <version>0.1.0</version>
  <description>RRT/Reeds-Shepp path planning with rectangular footprint collision checking.</description>
  <maintainer email="benaziel@seas.upenn.edu">azielben</maintainer>
  <license>N/A</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>trusses_custom_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
